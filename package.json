{
  "name": "victa-perso-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest --passWithNoTests",
    "lint:cs": "node scripts/czech-typography-lint.mjs",
    "lint:i18n": "node scripts/i18n-parity-check.mjs",
    "gen:chat": "node scripts/generate-chat-knowledge.mjs",
    "gen:chat:check": "node scripts/generate-chat-knowledge.mjs --check",
    "e2e": "playwright test",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execSync('husky', {stdio: 'inherit'})\" || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/supabase-js": "^2.106.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.48",
    "dompurify": "^3.4.5",
    "framer-motion": "^12.40.0",
    "isomorphic-dompurify": "^3.14.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.12",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.76.1",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "undici": ">=7.28.0",
      "postcss": ">=8.5.18",
      "brace-expansion@>=5.0.0 <5.0.8": ">=5.0.8",
      "sharp": ">=0.35.0"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "./.eslint-legacy.sh"
    ],
    "*.{js,jsx,mjs}": [
      "./.eslint-legacy.sh"
    ]
  }
}
