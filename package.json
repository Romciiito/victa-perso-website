{
  "name": "victa-perso-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest --passWithNoTests",
    "lint:cs": "node scripts/czech-typography-lint.mjs",
    "e2e": "playwright test",
