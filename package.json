{
  "name": "victa-perso-website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest --passWithNoTests",
    "lint:cs": "node scripts/czech-typography-lint.mjs",
    "lint:i18n": "node scripts/i18n-parity-check.mjs",
    "gen:chat": "node scripts/generate-chat-knowledge.mjs",
    "gen:chat:check": "node scripts/generate-chat-knowledge.mjs --check",
    "e2e": "playwright test",
    "prepare": "node -e \"if (!process.env.CI) require('child_process').execSync('husky', {stdio: 'inherit'})\" || true"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.8.0",
    "@sentry/nextjs": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.65",
    "botid": "^1.5.11",
    "dompurify": "^3.4.13",
    "framer-motion": "^13.1.0",
    "isomorphic-dompurify": "^3.22.0",
    "libphonenumber-js": "^1.13.10",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.6",
    "next-themes": "^0.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "resend": "^6.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "undici": ">=7.28.0",
      "postcss": ">=8.5.18",
      "brace-expansion@>=5.0.0 <5.0.8": ">=5.0.8",
      "sharp": ">=0.35.0",
      "nanoid": ">=3.3.17"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "./.eslint-legacy.sh"
    ],
    "*.{js,jsx,mjs}": [
      "./.eslint-legacy.sh"
    ]
  }
}
