#!/usr/bin/env sh
# VICTA pre-commit hook
# Blocks commits that contain secret-like patterns using gitleaks.
# Requires: gitleaks installed (brew install gitleaks)
# Config:   .gitleaks.toml at repo root

# Run gitleaks against staged changes only.
# gitleaks protect --staged scans only the staged diff.
gitleaks protect --staged --source . --config .gitleaks.toml 2>/dev/null || \
gitleaks detect --source . --config .gitleaks.toml 2>/dev/null

STATUS=$?
if [ $STATUS -ne 0 ]; then
  echo ""
  echo "gitleaks: potential secret detected in staged files."
  echo "Commit blocked. Review the output above, remove or rotate the secret, then re-stage."
  echo ""
  exit 1
fi

# Run lint-staged (ESLint on changed TS/JS files)
npx lint-staged

# Banned patterns guard (taste-skill anti-slop)
./scripts/banned-patterns.sh
