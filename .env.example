# ── Vercel platform ───────────────────────────────────────────────────────────
VERCEL_PROJECT_ID=your-vercel-project-id-here

# ── Supabase Postgres (Frankfurt eu-central-1) ────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL is public-safe: it's the project URL visible in JS bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Service key is server-only — NEVER expose in client bundle
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# ── Upstash Redis (rate limiting state) ───────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ── Resend (email + newsletter) ───────────────────────────────────────────────
# Two separate keys per security-model.md §4.10 (newsletter audience CRUD vs sending-only)
RESEND_API_KEY_NEWSLETTER=re_your-newsletter-key-here
RESEND_API_KEY_CONTACT=re_your-contact-key-here
RESEND_FROM_EMAIL=hello@victaagency.com
RESEND_AUDIENCE_ID=your-audience-id-here
# Where /api/contact delivers form submissions (Roman's inbox)
CONTACT_DESTINATION_EMAIL=inbox@example.com

# ── Cal.com (booking widget + webhook) ────────────────────────────────────────
# Public username — used by booking widget to construct cal.com/<username>/<event>
NEXT_PUBLIC_CALCOM_USERNAME=victa
# Webhook HMAC secret — server-only, verified in /api/booking-webhook (AR-11)
CALCOM_WEBHOOK_SECRET=your-calcom-webhook-secret-here

# ── Newsletter double opt-in confirmation token (P1-07, D-014) ────────────────
# Server-only HMAC-SHA256 signing key for the stateless /api/newsletter/confirm
# link (email+locale+timestamp payload, 48h expiry). NEVER prefix with
# NEXT_PUBLIC_ — this secret proves a confirmation link is genuine; anyone who
# has it can forge "consent" for an arbitrary email address. Generate with
# e.g. `openssl rand -hex 32`. Set a DIFFERENT value per Vercel environment
# (Production / Preview / Development) — a leaked Preview secret must not be
# able to forge a Production consent record.
NEWSLETTER_CONFIRM_SECRET=your-newsletter-confirm-secret-here

# ── IP hash salt (server-side only — for stable rate-limit + audit log keys) ─
IP_HASH_SALT=replace-with-random-32-byte-hex-in-production

# ── Cloudflare Turnstile (bot defense) ────────────────────────────────────────
# Site key is public-safe: embedded in the HTML page for the Turnstile widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
# Secret key is server-only — used only in Vercel Function to verify tokens
TURNSTILE_SECRET_KEY=your-turnstile-secret-here

# ── Sentry ────────────────────────────────────────────────────────────────────
# Server DSN — server-only error reporting
SENTRY_DSN=https://your-sentry-dsn-here
# Public DSN — safe for client bundle (identifies your Sentry project, not a secret)
NEXT_PUBLIC_SENTRY_DSN=https://your-public-sentry-dsn-here

# ── GA4 ───────────────────────────────────────────────────────────────────────
# Measurement ID is public-safe: visible in page source by design
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Cookiebot ─────────────────────────────────────────────────────────────────
# CBID is public-safe: embedded in the Cookiebot script tag in <head>
NEXT_PUBLIC_COOKIEBOT_ID=your-cookiebot-cbid-here

# ── AI Gateway / Chatbot (Vlna 5 — code shipped, DORMANT until flag flip) ─────
# The chatbot ships fully coded but inert: the widget only mounts when
# NEXT_PUBLIC_CHATBOT_ENABLED === '1' below, and /api/chat itself fails
# closed (503 {disabled:true}) unless AI_MODEL + Upstash env are all present
# (src/lib/chat/config-gate.ts). See docs/setup/chatbot-activation.md for the
# full activation runbook (provisioning -> adversarial battery -> flag flip).
#
# Model string routed through the Vercel AI Gateway (AR-01) — e.g.
# "anthropic/claude-sonnet-4-5". NEVER import @anthropic-ai/sdk or
# @ai-sdk/anthropic directly; this env var is the ONLY model config surface.
AI_MODEL=anthropic/claude-sonnet-4-5
# AI Gateway auth — on Vercel, prefer OIDC (automatic when AI Gateway is
# enabled for the project; no key needed). Set this explicitly only for
# local dev or a non-Vercel environment. Server-only.
AI_GATEWAY_API_KEY=your-ai-gateway-api-key-here
# Chatbot also requires UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
# above (rate limiting — three independent dimensions, AR-17).
#
# Feature flag — client-visible by design (controls whether the widget
# mounts at all; it is not a secret). Leave unset/'0' until BOTH:
#   1. AI_MODEL + AI_GATEWAY_API_KEY (or Vercel OIDC) + Upstash are
#      provisioned in this environment, AND
#   2. the adversarial prompt-injection battery has been run and passed:
#      CHAT_BATTERY=1 pnpm vitest run src/lib/chat/__tests__/adversarial-battery.test.ts
# vision.md §14 bod 12 — do not flip without both. See
# docs/setup/chatbot-activation.md for the exact sequence.
NEXT_PUBLIC_CHATBOT_ENABLED=0
